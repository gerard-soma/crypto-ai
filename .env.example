# Skopiuj ten plik jako .env i wklej swój klucz. Pliku .env nikomu nie wysyłaj.
HELIUS_API_KEY=

# Opcjonalne: klucz z portal.jup.ag, jeśli darmowe lite-api Jupitera przestanie działać.
JUP_API_KEY=

# Ustawienia agenta (wartości domyślne):
# MIN_BUY_USD=150        od jakiej kwoty zakupu portfel uznajemy za duży
# MIN_WIN_ROI=1.0        1.0 = portfel co najmniej podwoił pieniądze na tokenie
# MAX_WALLETS=30         ile portfeli obserwujemy
# DISCOVERY_TOKENS=15    na ilu rosnących tokenach szukamy portfeli
# LOOKBACK_HOURS=24      okno raportu
# MIN_SIGNAL_USD=50      minimalny zakup netto, który liczymy jako sygnał
# MAX_TRADES_PER_DAY=20  portfele z większą liczbą zamian dziennie (boty, skalperzy) pomijamy
# PROFILE_PAGES=3        ile stron po 100 transakcji historii portfela sprawdzamy
# MIN_TOKENS=3           na ilu tokenach portfel musi mieć ocenialny wynik
# MIN_WINS=2             na ilu różnych tokenach musi być na plusie
# MIN_WIN_RATE=0.3       odsetek tokenów na plusie
# MIN_HOLD_HOURS=1       mediana czasu od zakupu do sprzedaży; krócej = flipper

# Budżet Helius (wartości domyślne):
# HELIUS_MONTHLY_BUDGET=300000  twardy limit kredytów na miesiąc; licznik w dane/helius.json
# DISCOVERY_COOLDOWN_H=20       odkrywanie najwyżej raz na tyle godzin (odkryj --wymus pomija)
# REPORT_CACHE_MIN=60           raport młodszy niż tyle minut pokazujemy z pamięci (raport --swiezy pomija)

# Twój prywatny portfel: tylko adres publiczny, do odczytu w diagnozie. Nigdy nie wpisuj tu klucza prywatnego.
# PRYWATNY_PORTFEL=

# Limity handlu (wartości domyślne):
# MAX_TRADE_USD=10       największy pojedynczy zakup
# MAX_DAILY_USD=25       suma zakupów w ciągu 24 h
# MAX_SLIPPAGE_BPS=300   maksymalny poślizg (300 = 3%)
# MAX_BUY_IMPACT_PCT=3   maksymalny wpływ na cenę przy zakupie
# MAX_SELL_IMPACT_PCT=15 przy sprzedaży akceptujemy więcej, żeby dało się wyjść
# SOL_RESERVE=0.02       SOL, który zawsze zostaje na opłaty
# TAKE_PROFIT_PCT=100    podpowiedź: sprzedaj połowę przy +100%
# STOP_LOSS_PCT=-40      podpowiedź: wyjdź przy −40%

# Snajper nowych tokenów (wartości domyślne):
# SNAJPER_USD=1                     stawka jednej pozycji (w kodzie najwyżej 5)
# SNAJPER_STRATEGIA=rozpęd          która strategia handluje naprawdę z --naprawde
# SNAJPER_MAX_OTWARTYCH=2           najwyżej tyle prawdziwych pozycji naraz
# SNAJPER_MAX_ZAKUPOW_DZIENNIE=10   prawdziwe zakupy w 24 h
# SNAJPER_MAX_STRATA_DZIENNIE_USD=3 strata w 24 h (otwarte pozycje liczą się jak stracone)
# SNAJPER_SOL_RESERVE=0.01          SOL, który zostaje na opłaty
# SNAJPER_ROZPED_PCT=50             rozpęd: wzrost od pierwszej ceny
# SNAJPER_OKNO_S=180                w ilu sekundach od startu tokenu
# SNAJPER_MAX_DEV_SOL=5             pomijamy tokeny, na które twórca wydał na starcie więcej
# SNAJPER_TP_PCT=100                przy tylu % sprzedajemy połowę
# SNAJPER_SL_PCT=-30                stop
# SNAJPER_TRAIL_PCT=30              ruchomy stop od szczytu po realizacji połowy
# SNAJPER_MAX_S=600                 wyjście najpóźniej po tylu sekundach
# SNAJPER_POLL_S=3                  co ile sekund ceny z Jupitera
# SNAJPER_MAX_SLIPPAGE_BPS=2500     Jupiter daje świeżym tokenom zwykle 2000
